# ── Agora ──────────────────────────────────────────────────────────────
AGORA_APP_ID=your_agora_app_id_here
AGORA_APP_CERTIFICATE=your_agora_app_certificate_here
AGORA_CUSTOMER_ID=your_agora_customer_id_here
AGORA_CUSTOMER_SECRET=your_agora_customer_secret_here

# UID used by the AI agent in the RTC channel (must differ from the user UID)
AGORA_AGENT_UID=10001

# ── LLM ────────────────────────────────────────────────────────────────
# managed = Agora-hosted OpenAI. custom = OpenAI-compatible URL + key below.
LLM_MODE=managed
CURSOR_API_URL=https://api.openai.com/v1/chat/completions
CURSOR_API_KEY=
CURSOR_MODEL=gpt-4o-mini

# ── TTS ────────────────────────────────────────────────────────────────
# managed = Agora MiniMax. murf = Murf Falcon BYOK (valid key required).
TTS_MODE=managed
MURF_API_KEY=ap-your_murf_api_key_here
# Falcon streaming voice IDs: Natalie | Matthew | Gordon (not en-US-natalie)
MURF_VOICE_ID=Natalie
MURF_MODEL=falcon-2.1
MURF_STYLE=Conversational

# ── Backend ────────────────────────────────────────────────────────────
# Public URL of this backend (for Agora to call your tool endpoints)
# Use https://your-domain.com or an ngrok tunnel during development
BACKEND_PUBLIC_URL=http://localhost:8000

# ── Google Calendar ────────────────────────────────────────────────────
# 1. Google Cloud Console → enable Google Calendar API
# 2. Create OAuth client (Web application)
# 3. Add redirect URI: http://localhost:8000/api/google/callback
# 4. Paste client id/secret, restart backend, open /api/google/connect
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/google/callback
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_TIMEZONE=Asia/Kolkata
GOOGLE_REFRESH_TOKEN=

# ── Employee (demo context) ────────────────────────────────────────────
DEMO_EMPLOYEE_NAME=Alex Johnson
DEMO_EMPLOYEE_ROLE=Senior Software Engineer
DEMO_EMPLOYEE_TEAM=Platform Engineering
